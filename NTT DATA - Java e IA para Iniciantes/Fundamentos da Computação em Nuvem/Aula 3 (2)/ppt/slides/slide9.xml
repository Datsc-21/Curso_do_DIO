ang="pt-BR" sz="1163" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Segoe UI Semibold"/><a:ea typeface="Segoe UI Semibold"/><a:cs typeface="Segoe UI Semibold"/></a:rPr><a:t>Use as interfaces de linha de comando do Azure e do Docker para gerenciar imagens e operações no registro de contêiner.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="5" name="TextBox 4"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{12747CC8-4C90-58F8-378C-7364C04C2A0E}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="441197" y="1365235"/><a:ext cx="7551921" cy="3323987"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr marL="214313" indent="-214313"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/><a:cs typeface="Segoe UI"/></a:rPr><a:t>Fazer logon no registro de contêiner – você precisa fazer logon no registro antes de efetuar pull e push de imagens de contêiner.</a:t></a:r></a:p><a:p><a:pPr marL="214313" indent="-214313"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>az acr login --name mycontainerregistry</a:t></a:r><a:endParaRPr lang="en-US" sz="1200" dirty="0"><a:latin typeface="Consolas" panose="020B0609020204030204" pitchFamily="49" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr lvl="1"/><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr marL="214313" indent="-214313"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/><a:cs typeface="Segoe UI"/></a:rPr><a:t>Efetuar push de uma imagem para o registro de contêiner – as etapas para enviar uma imagem incluem criar, marcar, efetuar push e remover o local.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>docker pull mcr.microsoft.com/hello-world</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>docker tag mcr.microsoft.com/hello-world myacr.azurecr.io/hello-world:v1</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>docker push myacr.azurecr.io/hello-world:v1</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>docker rmi myacr.azurecr.io/hello-world:v1</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr marL="214313" indent="-214313"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/><a:cs typeface="Segoe UI"/></a:rPr><a:t>Efetuar pull e remover imagens do registro – use os comandos do Docker e do Azure para efetuar pull </a:t></a:r><a:br><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/><a:cs typeface="Segoe UI"/></a:rPr></a:br><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/><a:cs typeface="Segoe UI"/></a:rPr><a:t>e remover imagens</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>docker pull myacr.azurecr.io/hello-world:v1</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="pt-BR" sz="1200" dirty="0"><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>az acr repository delete --name myacr --image hello-world:v1</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="2" name="Footer Placeholder 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{8AFBEE60-FD8C-A0CF-7078-D82CFC31F743}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="ftr" sz="quarter" idx="3"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="434579" y="4815812"/><a:ext cx="3113484" cy="148482"/></a:xfrm></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="pt-BR"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:latin typeface="Segoe UI"/><a:ea typeface="Segoe UI"/><a:cs typeface="Segoe UI"/></a:rPr><a:t>© Copyright Microsoft Corporation. Todos os direitos reservados.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3318109639"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr><p:transition><p:fade/></p:transition></p:sld>